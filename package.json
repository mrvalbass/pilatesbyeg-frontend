{
	"name": "pilatesbyeg-frontend",
	"version": "0.1.0",
	"private": true,
	"scripts": {
		"dev": "next dev --turbopack",
		"build": "next build",
		"start": "next start",
		"lint": "next lint",
		"lint:fix": "next lint --fix",
		"format": "prettier --write .",
		"format:check": "prettier --check",
		"test": "jest --passWithNoTests",
		"test:watch": "jest --passWithNoTests --watch",
		"test:coverage": "jest --passWithNoTests --coverage",
		"type-check": "tsc --noEmit",
		"clean": "rm -rf .next out node_modules ./src/tests/coverage",
		"type-generation": "openapi-typescript http://localhost:3100/api-json -o src/types/api/types.generated.ts prettier --write src/types/api/types.generated.ts"
	},
	"dependencies": {
		"@tanstack/react-form": "^1.14.1",
		"@tanstack/react-query": "^5.83.0",
		"next": "^15.3.5",
		"react": "^19.1.0",
		"react-dom": "^19.1.0",
		"react-icons": "^5.5.0",
		"zod": "^4.0.5",
		"zustand": "^5.0.6"
	},
	"devDependencies": {
		"@eslint/eslintrc": "^3.3.1",
		"@react-spring/web": "^10.0.1",
		"@swc/core": "^1.12.11",
		"@swc/jest": "^0.2.39",
		"@tailwindcss/postcss": "^4.1.11",
		"@tanstack/react-query-devtools": "^5.83.0",
		"@testing-library/dom": "^10.4.0",
		"@testing-library/jest-dom": "^6.6.3",
		"@testing-library/react": "^16.3.0",
		"@types/eslint-plugin-jsx-a11y": "^6.10.0",
		"@types/jest": "^30.0.0",
		"@types/node": "^24.0.13",
		"@types/react": "^19.1.8",
		"@types/react-dom": "^19.1.6",
		"@typescript-eslint/eslint-plugin": "^8.36.0",
		"@typescript-eslint/parser": "^8.36.0",
		"autoprefixer": "^10.4.21",
		"clsx": "^2.1.1",
		"daisyui": "^5.0.46",
		"eslint": "^9.31.0",
		"eslint-config-next": "15.3.5",
		"eslint-config-prettier": "^10.1.5",
		"eslint-import-resolver-typescript": "^4.4.4",
		"eslint-plugin-import": "^2.32.0",
		"eslint-plugin-jsx-a11y": "^6.10.2",
		"eslint-plugin-prettier": "^5.5.1",
		"jest": "^30.0.4",
		"jest-environment-jsdom": "^30.0.4",
		"motion": "^12.23.3",
		"openapi-typescript": "^7.8.0",
		"postcss": "^8.5.6",
		"prettier": "^3.6.2",
		"prettier-plugin-organize-imports": "^4.1.0",
		"prettier-plugin-tailwindcss": "^0.6.14",
		"tailwindcss": "^4.1.11",
		"ts-jest": "^29.4.0",
		"ts-node": "^10.9.2",
		"typescript": "5.7.3"
	},
	"packageManager": "yarn@4.9.2"
}
