{
	"name": "pilatesbyeg-frontend",
	"version": "0.1.0",
	"private": true,
	"scripts": {
		"dev": "next dev --port 4000",
		"build": "next build",
		"start": "next start",
		"lint": "biome check .",
		"lint:fix": "biome check --write .",
		"format": "biome format .",
		"format:fix": "biome format --write .",
		"test": "vitest run",
		"test:watch": "vitest watch",
		"test:coverage": "vitest run --coverage",
		"type-check": "tsc --noEmit",
		"clean": "rm -rf .next out node_modules ./src/tests/coverage",
		"type-generation": "openapi-typescript http://localhost:4100/api-json -o src/types/api/types.generated.ts prettier --write src/types/api/types.generated.ts"
	},
	"dependencies": {
		"@react-spring/web": "^10.1.2",
		"@tanstack/react-form": "^1.33.0",
		"@tanstack/react-query": "^5.101.2",
		"clsx": "^2.1.1",
		"daisyui": "^5.6.3",
		"gsap": "^3.15.0",
		"motion": "^12.42.0",
		"next": "^16.2.9",
		"react": "^19.2.7",
		"react-dom": "^19.2.7",
		"react-icons": "^5.6.0",
		"zod": "^4.4.3",
		"zustand": "^5.0.14"
	},
	"devDependencies": {
		"@biomejs/biome": "^2.5.1",
		"@swc/core": "^1.15.43",
		"@tailwindcss/postcss": "^4.3.1",
		"@tanstack/react-query-devtools": "^5.101.2",
		"@testing-library/dom": "^10.4.1",
		"@testing-library/react": "^16.3.2",
		"@types/node": "^26.0.1",
		"@types/react": "^19.2.17",
		"@types/react-dom": "^19.2.3",
		"@vitest/coverage-v8": "^4.1.9",
		"autoprefixer": "^10.5.2",
		"babel-plugin-react-compiler": "^1.0.0",
		"jsdom": "^29.1.1",
		"openapi-typescript": "^7.13.0",
		"postcss": "^8.5.15",
		"tailwindcss": "^4.3.1",
		"ts-node": "^10.9.2",
		"typescript": "6.0.3",
		"vitest": "^4.1.9"
	},
	"packageManager": "pnpm@10.33.0+sha512.10568bb4a6afb58c9eb3630da90cc9516417abebd3fabbe6739f0ae795728da1491e9db5a544c76ad8eb7570f5c4bb3d6c637b2cb41bfdcdb47fa823c8649319"
