{
	"name": "pilatesbyeg-frontend",
	"version": "0.1.0",
	"private": true,
	"scripts": {
		"dev": "next dev --turbopack --port 4000",
		"build": "next build",
		"start": "next start",
		"lint": "eslint .",
		"lint:fix": "eslint --fix .",
		"format": "prettier --write .",
		"format:check": "prettier --check",
		"test": "jest --passWithNoTests",
		"test:watch": "jest --passWithNoTests --watch",
		"test:coverage": "jest --passWithNoTests --coverage",
		"type-check": "tsc --noEmit",
		"clean": "rm -rf .next out node_modules ./src/tests/coverage",
		"type-generation": "openapi-typescript http://localhost:4100/api-json -o src/types/api/types.generated.ts prettier --write src/types/api/types.generated.ts"
	},
	"dependencies": {
		"@tanstack/react-form": "^1.23.4",
		"@tanstack/react-query": "^5.90.2",
		"next": "^15.5.4",
		"react": "^19.1.1",
		"react-dom": "^19.1.1",
		"react-icons": "^5.5.0",
		"zod": "^4.1.11",
		"zustand": "^5.0.8"
	},
	"devDependencies": {
		"@eslint-react/eslint-plugin": "^2.0.1",
		"@eslint/eslintrc": "^3.3.1",
		"@eslint/js": "^9.36.0",
		"@react-spring/web": "^10.0.3",
		"@swc/core": "^1.13.5",
		"@swc/jest": "^0.2.39",
		"@tailwindcss/postcss": "^4.1.13",
		"@tanstack/react-query-devtools": "^5.90.2",
		"@testing-library/dom": "^10.4.1",
		"@testing-library/jest-dom": "^6.8.0",
		"@testing-library/react": "^16.3.0",
		"@types/eslint-plugin-jsx-a11y": "^6.10.0",
		"@types/jest": "^30.0.0",
		"@types/node": "^24.5.2",
		"@types/react": "^19.1.15",
		"@types/react-dom": "^19.1.9",
		"@typescript-eslint/eslint-plugin": "^8.44.1",
		"@typescript-eslint/parser": "^8.44.1",
		"autoprefixer": "^10.4.21",
		"clsx": "^2.1.1",
		"daisyui": "^5.1.25",
		"eslint": "^9.36.0",
		"eslint-config-next": "^15.5.4",
		"eslint-config-prettier": "^10.1.8",
		"eslint-import-resolver-typescript": "^4.4.4",
		"eslint-plugin-import": "^2.32.0",
		"eslint-plugin-jsx-a11y": "^6.10.2",
