		"jest-environment-jsdom": "^30.2.0",
		"motion": "^12.23.22",
		"openapi-typescript": "^7.9.1",
		"postcss": "^8.5.6",
		"prettier": "^3.6.2",
		"prettier-plugin-organize-imports": "^4.3.0",
		"prettier-plugin-tailwindcss": "^0.6.14",
		"tailwindcss": "^4.1.13",
		"ts-jest": "^29.4.4",
		"ts-node": "^10.9.2",
